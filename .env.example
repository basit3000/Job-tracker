# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Generate a separate PostgreSQL password for Docker.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
MIGRATOR_DB_PASSWORD=
POSTGRES_USER=postgres
POSTGRES_DB=jobtracker
SESSION_COOKIE_SECURE=false
FLASK_DEBUG=false
PUBLIC_SIGNUP_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate once: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this private and stable across workers/restarts to decrypt sync credentials.
SYNC_ENCRYPTION_KEY=
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback
ALLOW_INSECURE_LOCAL_API=false
# Optional daily application reminder emails (off until configured).
EMAIL_REMINDERS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
# starttls (usually port 587) or ssl (usually port 465); TLS is required.
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
APP_BASE_URL=http://localhost:5000
# For HTTPS proxies, trust only the exact proxy address; never '*'.
# FORWARDED_ALLOW_IPS=127.0.0.1
# Local single-process development uses memory://; deployments need shared storage.
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0
