# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Generate a separate PostgreSQL password for Docker.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
MIGRATOR_DB_PASSWORD=
POSTGRES_USER=postgres
POSTGRES_DB=jobtracker
SESSION_COOKIE_SECURE=false
FLASK_DEBUG=false
PUBLIC_SIGNUP_ENABLED=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate once: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this private and stable across workers/restarts to decrypt sync credentials.
SYNC_ENCRYPTION_KEY=
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback
ALLOW_INSECURE_LOCAL_API=false
# Optional daily application reminder emails (off until configured).
# Global switch for all opt-in notification and daily reminder emails.
EMAIL_REMINDERS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
# starttls (usually port 587) or ssl (usually port 465); TLS is required.
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
APP_BASE_URL=http://localhost:5000
# For HTTPS proxies, trust only the exact proxy address; never '*'.
# FORWARDED_ALLOW_IPS=127.0.0.1
# Local single-process development uses memory://; deployments need shared storage.
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0

# Cloud hosting: see docs/cloud-deployment.md. Set these in provider settings,
# not in committed files. Vercel/Railway enable production validation.
# APP_ENV=production
# DATABASE_URL=
# MIGRATION_DATABASE_URL=
# GRANT_RUNTIME_ROLE=false
# SESSION_COOKIE_SECURE=true
# APP_BASE_URL=https://your-domain.example
# UPLOAD_STORAGE=s3
# S3_BUCKET=
# S3_ENDPOINT_URL=https://your-s3-compatible-endpoint.example
# S3_REGION=us-east-1
# S3_ADDRESSING_STYLE=virtual
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# CRON_SECRET=
# Railway filesystem alternative: attach a volume at this path.
# UPLOAD_STORAGE=filesystem
# UPLOAD_FOLDER=/app/uploads
# WEB_CONCURRENCY=2
# PORT is provided by the platform; defaults to 5000 locally.
# Managed platforms trust one forwarded protocol header automatically.
# Custom proxy deployments must configure their own exact trust counts.
# PROXY_PROTO_COUNT=1
# PROXY_FOR_COUNT=1
