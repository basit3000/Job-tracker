SECRET_KEY=replace-with-a-long-random-string
SESSION_COOKIE_SECURE=false
FLASK_DEBUG=true

# Local SQLite is the default when DATABASE_URL is unset.
# DATABASE_URL=sqlite:///jobtracker.db

# Docker / PostgreSQL (docker-compose defaults shown)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=jobtracker
# DATABASE_URL is built by docker-compose for the web service.
